# Hevy — no Pro subscription needed. This repo uses hevy-unofficial (a
# reverse-engineered client) instead of the official Pro-gated API. One-time
# setup: run `python scripts/hevy_login.py` and follow its instructions,
# then set the same email here.
HEVY_EMAIL=

# intervals.icu — https://intervals.icu/settings (Developer Settings, near the bottom)
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=

# Garmin Connect Personal API key, for activities and daily metrics.
# Create it at https://connect.garmin.com/app/settings/personalApiToken
GARMIN_PERSONAL_API_KEY=

# Garmin Connect login, used only to read your club's workout calendar via
# garmin-givemydata (the Personal API has no calendar endpoint). Stays local.
# Never commit this file.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where the SQLite DB lives
DB_PATH=data/athlete.db
